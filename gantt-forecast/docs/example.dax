// Power BI: Моделирование → Новая таблица. Назначьте тип Дата колонкам дат.
Работы =
UNION (
    ROW ( "Работа", "Поздний прогноз", "Дата начала", DATE ( 2026, 1, 1 ), "Дата окончания", DATE ( 2026, 2, 1 ), "Прогнозная дата завершения", DATE ( 2026, 3, 1 ) ),
    ROW ( "Работа", "Ранний прогноз", "Дата начала", DATE ( 2026, 1, 5 ), "Дата окончания", DATE ( 2026, 2, 5 ), "Прогнозная дата завершения", DATE ( 2026, 1, 20 ) ),
    ROW ( "Работа", "По плану", "Дата начала", DATE ( 2026, 1, 1 ), "Дата окончания", DATE ( 2026, 2, 1 ), "Прогнозная дата завершения", DATE ( 2026, 2, 1 ) ),
    ROW ( "Работа", "Без прогноза", "Дата начала", DATE ( 2026, 1, 1 ), "Дата окончания", DATE ( 2026, 2, 1 ), "Прогнозная дата завершения", BLANK () ),
    ROW ( "Работа", "Ошибка прогноза", "Дата начала", DATE ( 2026, 1, 10 ), "Дата окончания", DATE ( 2026, 2, 1 ), "Прогнозная дата завершения", DATE ( 2026, 1, 1 ) )
)
